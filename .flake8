[flake8]
max-line-length = 120
exclude = .git,__pycache__,venv,.venv
per-file-ignores =
    redscope/dashboard/app.py:E501
    redscope/modules/report/html.py:E501
    redscope/modules/network/serviceenum.py:E501
    redscope/modules/network/osfingerprint.py:E501
    redscope/modules/recon/emailsec.py:E501
    redscope/modules/recon/portscan.py:E501
    redscope/modules/web/cors.py:E501
    redscope/modules/web/dirbrute.py:E501
    redscope/modules/web/idor.py:E501,E203
    redscope/modules/web/openredirect.py:E501
    redscope/modules/web/waf.py:E501
    redscope/modules/web/xxe.py:E501
